#version 450
#include "math.glsl"

#define MAX_CONTRIBUTION 10
#define NUM_OF_SAMPLES 1024 // Increasing this increases quality but may cause GPU to timeout

// When multiplied, it is recommended that the total value is in the range 128 - 512 for better occupancy
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ------
// Samplers
// ------

// Input equirectangular image
layout(binding = 0) uniform samplerCube inputImage;

// Input image and mipmap metadata
layout(push_constant) uniform EnvironmentMapComputeConstants
{
	uvec2 input_image_size;
	uint current_mipmap;
	uint total_mipmap_num;
} env_map_compute_constants;

// Output prefiltered map (equirectangular)
layout(binding = 1) uniform writeonly image2D outputPrefilteredMap;

// ------
// Main
// ------

void main()
{
	ivec2 outputImageSize = imageSize(outputPrefilteredMap).xy;
	vec2 currentUv = (gl_GlobalInvocationID.xy + 0.5) / outputImageSize;

	vec4 color = vec4(0);
	float totalWeight = 0;

	// Calculate current mipmap's roughness
	float roughness = float(env_map_compute_constants.current_mipmap) / float(env_map_compute_constants.total_mipmap_num - 1);

	// Convert from equirectangular UV to spherical coordinates
	float currentTheta = currentUv.x * 2 * PI;
	float currentPhi = currentUv.y * PI;

	// Get current pixel's normal in cubemap space
	vec3 normal = getDirectionVectorFromSphereCoords(currentTheta, currentPhi);

	// Approximate integral by averaging samples around the sample normal using a low-discrepancy sequence (Hammersley),
	// and GGX normal distribution function. Roughness is adjusted per mipmap level to represent different roughness
	// values
	for (uint i = 0; i < NUM_OF_SAMPLES; i++)
	{
		vec2 sequenceValue = hammersleySequence(i, NUM_OF_SAMPLES);
		vec3 ggxVector = ggxSample(sequenceValue, normal, roughness);
		vec3 sampleVector = normalize(2 * dot(normal, ggxVector) * ggxVector - normal);

		// Only consider samples in the hemisphere around the normal
		float contribution = max(dot(normal, sampleVector), 0);
		if (contribution > 0)
		{
            // Some HDR textures have extremely bright values that can cause artifacts on the prefiltered map
            // It is better to clamp the HDR values, just in case
            vec4 sampleColor = texture(inputImage, sampleVector);
            sampleColor = normalize(sampleColor) * min(length(sampleColor), MAX_CONTRIBUTION);

			color += sampleColor * contribution;
			totalWeight += contribution;
		}
	}

	color = color / totalWeight;
	imageStore(outputPrefilteredMap, ivec2(gl_GlobalInvocationID.xy), color);
}
#version 450
#include "math.glsl"

#define NUM_OF_SAMPLES 1024 // Increasing this increases quality but may cause GPU to timeout

// When multiplied, it is recommended that the total value is in the range 128 - 512 for better occupancy
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Output BRDF integration map (RG channels)
// R channel stores the first component of the BRDF split-sum approximation. G stores the second component
layout(binding = 0) uniform writeonly image2D brdfIntegrationMap;

// ------
// Main
// ------

void main()
{
	ivec2 outputImageSize = imageSize(brdfIntegrationMap).xy;

	// UV values are the LUT inputs
	// UV.x represents the dot product between the normal and the view angle
	// UV.y represents the roughness value
	vec2 currentUv = (gl_GlobalInvocationID.xy + 0.5) / outputImageSize;
	float NdotV = currentUv.x;
	float roughness = currentUv.y;

	// Input vector and normal Y <-> Z axes are swapped to match renderer's coordinates
	vec3 inputVector = vec3(sqrt(1 - NdotV * NdotV), NdotV, 0);
	vec3 normal = vec3(0, 1, 0);
	vec2 brdfOutput = vec2(0);

	// Approximate the BRDF integral with quasi Monte Carlo sampling
	for (uint i = 0; i < NUM_OF_SAMPLES; i++)
	{
		vec2 sequenceValue = hammersleySequence(i, NUM_OF_SAMPLES);
		vec3 ggxVector = ggxSample(sequenceValue, normal, roughness);
		vec3 sampleVector = normalize(2 * dot(inputVector, ggxVector) * ggxVector - inputVector);

		float NdotL = max(sampleVector.y, 0);
		float NdotH = max(ggxVector.y, 0);
		float VdotH = max(dot(inputVector, ggxVector), 0);

		// Only consider samples in the hemisphere around the input vector
		if (NdotL > 0)
		{
			float geometryFn = geometrySmith(normal, inputVector, sampleVector, roughness);
			float geometryVis = (geometryFn * VdotH) / (NdotH * NdotV);
			float fc = pow(1 - VdotH, 5);

			brdfOutput.x += (1 - fc) * geometryVis;
			brdfOutput.y += fc * geometryVis;
		}
	}

	brdfOutput = brdfOutput / float(NUM_OF_SAMPLES);
	imageStore(brdfIntegrationMap, ivec2(gl_GlobalInvocationID.xy), vec4(brdfOutput, 0, 0));
}